# Rendered at container start: ${SITE_DOMAIN} and ${PANEL_PATH} come from .env.
server_tokens off;
client_max_body_size 2m;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript application/json image/svg+xml;

limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=panel:10m rate=30r/m;
limit_req_status 429;

proxy_cache_path /var/cache/nginx/static levels=1:2 keys_zone=static:10m max_size=200m inactive=7d use_temp_path=off;

# The test site stays out of search engines.
map $host $robots_tag {
    default "";
    "~^test\." "noindex, nofollow";
}

# Requests for any other host name (scanners hitting the IP address) get nothing.
server {
    listen 80 default_server;
    server_name _;
    location = /nginx-health { access_log off; return 200 "ok\n"; }
    location / { return 444; }
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name ${SITE_DOMAIN};
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SITE_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${SITE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # The app sets some of these too; one copy each, from here.
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Robots-Tag $robots_tag always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Look the containers up on every deploy instead of keeping the addresses from startup.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $web http://web:3000;
    set $api http://api:8000;

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass $api;
    }

    location /${PANEL_PATH}/ {
        limit_req zone=panel burst=30 nodelay;
        proxy_pass $api;
    }

    location /django-static/ {
        proxy_cache static;
        proxy_cache_valid 200 7d;
        proxy_pass $api;
    }

    location /_next/static/ {
        proxy_cache static;
        proxy_cache_valid 200 7d;
        proxy_pass $web;
    }

    location / {
        proxy_pass $web;
    }
}
